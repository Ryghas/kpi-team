# Jira Cloud — pakai akun service dengan permission Browse Projects saja (read-only)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=kpi-reader@your-domain.com
JIRA_API_TOKEN=

# Cache hasil fetch Jira (detik)
JIRA_REVALIDATE_SECONDS=3600

# Basic auth untuk dashboard (data kinerja personal — jangan dibuka publik)
DASHBOARD_USER=
DASHBOARD_PASSWORD=
